#include <vector>
using namespace std;
 
int main() 
{
    int t; 
    cin >> t;
    while(t--)
    {
        int flag=0;
        int n;
        int x; 
        cin>>n >>x;
         vector <int> arr(n);
         for (int i=0; i < arr.size(); i++)
         {
            cin>>arr[i]; 
         }
          for (int i=0; i < arr.size(); i++)
         {
            if(arr[i]==x)
         {
            flag=1;
            break;
         }}
         if (flag==1)
         {
            cout<<"yes"<< endl; 
         }
         else{
            cout << "no"<< endl;
         }
         }
    }